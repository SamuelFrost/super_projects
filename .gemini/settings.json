{
  "mcpServers": {
    "chrome-devtools": {
      "command": "docker",
      "args": [
        "compose",
        "-f", ".devcontainer/compose.yaml",
        "--project-directory", ".devcontainer",
        "exec", "-T",
        "devcontainer",
        "mise", "exec", "--",
        "chrome-devtools-mcp",
        "--browser-url=http://127.0.0.1:9223"
      ],
      "timeout": 120000
    },
    "figma": {
      "httpUrl": "https://mcp.figma.com/mcp",
      "timeout": 120000
    }
  }
}
