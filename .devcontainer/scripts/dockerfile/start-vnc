#!/usr/bin/env bash
set -euo pipefail

export DISPLAY=${DISPLAY:-:99}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/desktop-runtime-$(id -u)}
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
exec 9>"$XDG_RUNTIME_DIR/start.lock"
flock 9

if ! DISPLAY="$DISPLAY" xset q >/dev/null 2>&1; then
  nohup desktop-session >/tmp/desktop-session.log 2>&1 9>&- &
  desktop_process_id=$!
  for ((attempt = 0; attempt < 100; attempt++)); do
    if [[ -r $XDG_RUNTIME_DIR/session.env ]] &&
      curl -fsS "http://127.0.0.1:${NOVNC_PORT:-6080}/" >/dev/null 2>&1 &&
      DISPLAY="$DISPLAY" xset q >/dev/null 2>&1; then
      break
    fi
    if ! kill -0 "$desktop_process_id" 2>/dev/null; then
      cat /tmp/desktop-session.log >&2
      exit 1
    fi
    sleep 0.2
  done
fi

if [[ ! -r $XDG_RUNTIME_DIR/session.env ]] ||
  ! curl -fsS "http://127.0.0.1:${NOVNC_PORT:-6080}/" >/dev/null; then
  echo 'Desktop startup failed; see /tmp/desktop-session.log and /tmp/kasmvnc.log.' >&2
  exit 1
fi
flock -u 9
exec 9>&-
chrome
echo "KasmVNC ready: http://localhost:${NOVNC_PORT:-6080}/ (use the published host port)"
echo "Chrome DevTools: http://localhost:${CHROME_REMOTE_DEBUGGING_PORT:-9223}"
