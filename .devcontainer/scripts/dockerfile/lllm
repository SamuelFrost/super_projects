#!/bin/sh
# Chat with this checkout's local model through the Agent Development Kit.
# OLLAMA_HOST and GEMMA_MODEL come from Compose. The server runs in the local-llm
# container; this command does not start one.
set -eu

if [ -z "${OLLAMA_HOST:-}" ] || [ -z "${GEMMA_MODEL:-}" ]; then
  echo "lllm: the local model is not configured." >&2
  echo "Set mem_limit and GEMMA_MODEL in .devcontainer/docker_compose_configuration_customizations/lllm/compose.lllm.override.yaml, then run devcontainer up." >&2
  exit 1
fi

# LiteLLM routes Ollama calls from this variable. Keep the server root, without /v1.
OLLAMA_API_BASE=${OLLAMA_HOST%/}
export OLLAMA_API_BASE

workspace_dir=${SUPER_PROJECTS_WORKDIR:-/workspaces}
devcontainer_dir=$(CDPATH= cd -- "${workspace_dir}/.devcontainer" && pwd)

if ! ollama show "$GEMMA_MODEL" >/dev/null 2>&1; then
  ollama pull "$GEMMA_MODEL" >&2
fi

# adk web serves every agent under this directory. The event view is the
# development UI for model requests, thinking, and tool calls.
if [ "${1:-}" = "web" ]; then
  shift
  exec adk web --port 8000 "$devcontainer_dir" "$@"
fi

export PYTHONPATH="${devcontainer_dir}${PYTHONPATH:+:$PYTHONPATH}"
exec /opt/google-adk/bin/python3 -m lllm.cli "$@"
