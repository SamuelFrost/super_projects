#!/bin/bash
# Report vendor launcher changes in container logs without preventing GUI startup.
check_desktop_launcher() {
	local desktop_entry=$1 command_pattern=$2 workspace_pattern=${3:-}
	if [ ! -r "$desktop_entry" ]; then
		echo "ERROR: Desktop launcher missing or unreadable: $desktop_entry" >&2
	elif ! grep -q '^Exec=' "$desktop_entry" || grep '^Exec=' "$desktop_entry" | grep -Evq "$command_pattern"; then
		echo "ERROR: Desktop launcher has unexpected commands or missing flags: $desktop_entry" >&2
	elif [ -n "$workspace_pattern" ] && ! grep -Eq "$workspace_pattern" "$desktop_entry"; then
		echo "ERROR: Desktop launcher missing workspace configuration: $desktop_entry" >&2
	fi
	return 0
}

for launcher_directory in /usr/share/applications "$HOME/Desktop"; do
	check_desktop_launcher "$launcher_directory/cursor.desktop" '^Exec=/usr/share/cursor/cursor --disable-gpu --disable-telemetry --disable-crash-reporter ' '^Exec=/usr/share/cursor/cursor .* --ozone-platform=x11 --new-window /workspaces %F$'
	check_desktop_launcher "$launcher_directory/chatgpt.desktop" '^Exec=chatgpt --disable-gpu '
	check_desktop_launcher "$launcher_directory/com.anthropic.Claude.desktop" '^Exec=claude-desktop --disable-gpu '
done

vscode_launcher_found=false
while IFS= read -r desktop_entry; do
	check_desktop_launcher "$desktop_entry" '^Exec=/usr/share/code/code --disable-gpu --disable-telemetry --disable-crash-reporter --ozone-platform=x11 '
	if grep -q '^Type=Application' "$desktop_entry" && ! grep -q '^NoDisplay=true' "$desktop_entry"; then
		vscode_launcher_found=true
		check_desktop_launcher "$HOME/Desktop/${desktop_entry##*/}" '^Exec=/usr/share/code/code --disable-gpu --disable-telemetry --disable-crash-reporter --ozone-platform=x11 ' '^Exec=/usr/share/code/code .* --new-window /workspaces %F$'
	fi
done < <(dpkg-query -L code 2>/dev/null | sed -n '\#^/usr/share/applications/.*\.desktop$#p')
if [ "$vscode_launcher_found" = false ]; then
	echo "ERROR: VS Code package contains no desktop launcher" >&2
fi
