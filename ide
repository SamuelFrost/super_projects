#!/bin/sh
# Open this project's devcontainer and workspace directly in a host IDE.
set -eu

usage() {
	cat <<'USAGE'
Usage: ./ide EDITOR [WORKSPACE.code-workspace] [-- EDITOR_ARGUMENTS...]
       ./ide --print-uri [WORKSPACE.code-workspace]

Examples:
  ./ide code
  ./ide cursor
  ./ide code team.code-workspace
  ./ide cursor -- --profile "Work"
  ./ide code team.code-workspace -- --reuse-window --disable-extensions
  ./ide code -- --help

Supported editors:
  Editors must be VS Code-compatible host commands with Dev Containers support
  and the --file-uri / --folder-uri CLI options. Other VS Code-based editors
  work only if they support that same connection format.
  For editors without remote support, such as Vim and Neovim, run them inside
  a running container using devcontainer exec or ./not_devcontainer:
    devcontainer exec vim
    ./not_devcontainer exec devcontainer vim

Editor arguments:
  Put the editor's own flags and values after --. Quote values containing spaces
  normally; each argument is forwarded unchanged. Flags without -- are rejected.
  A new window is opened by default. --reuse-window / -r and
  --new-window / -n after the separator replace that default.
  Use -- --help for the editor's help;
  ./ide --help shows this launcher's help. --print-uri accepts no editor flags.

The single .code-workspace file in the repository root is opened by default.
If there is no workspace file, the container's /workspaces folder is opened.
With multiple workspace files, specify the filename explicitly.
Run from Linux, macOS, or WSL (using a Windows editor's WSL launcher).
VS Code installs missing host Dev Containers support before opening the window,
and WSL support when launched from WSL. Profile and storage flags are respected.
USAGE
}

run_editor() {
	if [ -n "$windows_editor_executable" ]; then
		ELECTRON_RUN_AS_NODE=1 WSLENV="ELECTRON_RUN_AS_NODE/w:${WSLENV:-}" \
			"$windows_editor_executable" "$windows_editor_cli" "$@"
	else
		"$editor_command" "$@"
	fi
}

ensure_vscode_extensions() {
	# Use the same extension store and profile as the window being opened.
	editor_profile=
	editor_user_data_directory=
	editor_extensions_directory=
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--help | -h | --version | -v | --list-extensions | --install-extension | --install-extension=* | --uninstall-extension | --uninstall-extension=*) return ;;
		--profile | --user-data-dir | --extensions-dir)
			if [ "$#" -lt 2 ]; then
				printf 'Expected a value after %s.\n' "$1" >&2
				exit 2
			fi
			case "$1" in
			--profile) editor_profile=$2 ;;
			--user-data-dir) editor_user_data_directory=$2 ;;
			--extensions-dir) editor_extensions_directory=$2 ;;
			esac
			shift
			;;
		--profile=*) editor_profile=${1#*=} ;;
		--user-data-dir=*) editor_user_data_directory=${1#*=} ;;
		--extensions-dir=*) editor_extensions_directory=${1#*=} ;;
		esac
		shift
	done
	set --
	[ -z "$editor_profile" ] || set -- "$@" --profile "$editor_profile"
	[ -z "$editor_user_data_directory" ] || set -- "$@" --user-data-dir "$editor_user_data_directory"
	[ -z "$editor_extensions_directory" ] || set -- "$@" --extensions-dir "$editor_extensions_directory"
	if ! installed_extensions=$(run_editor "$@" --list-extensions); then
		printf 'Could not check VS Code host extensions.\n' >&2
		exit 1
	fi
	missing_extensions=false
	required_extensions=ms-vscode-remote.remote-containers
	if [ -n "${WSL_DISTRO_NAME:-}" ]; then
		required_extensions="$required_extensions ms-vscode-remote.remote-wsl"
	fi
	for extension_identifier in $required_extensions; do
		if ! printf '%s\n' "$installed_extensions" | tr -d '\r' | grep -Fxiq "$extension_identifier"; then
			printf 'Installing VS Code host extension %s...\n' "$extension_identifier" >&2
			set -- "$@" --install-extension "$extension_identifier"
			missing_extensions=true
		fi
	done
	if [ "$missing_extensions" = true ] && ! run_editor "$@"; then
		printf 'Could not install required VS Code host extensions.\n' >&2
		exit 1
	fi
}

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
'')
	usage >&2
	exit 2
	;;
esac

editor_command=$1
shift
workspace_filename=
if [ "$#" -gt 0 ] && [ "$1" != -- ]; then
	case "$1" in
	-*)
		printf 'Put editor flags after --. See ./ide --help for examples.\n' >&2
		exit 2
		;;
	esac
	workspace_filename=$1
	shift
fi
if [ "$#" -gt 0 ]; then
	if [ "$1" != -- ]; then
		usage >&2
		exit 2
	fi
	shift
fi
if [ "$editor_command" = --print-uri ] && [ "$#" -gt 0 ]; then
	printf '%s\n' '--print-uri accepts no editor arguments.' >&2
	exit 2
fi
workspace_directory=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
if [ ! -f "$workspace_directory/.devcontainer/devcontainer.json" ]; then
	printf 'Devcontainer configuration not found in %s\n' "$workspace_directory" >&2
	exit 1
fi

case "${editor_command##*/}" in
nvim | neovim | vim | vi)
	printf 'Run this editor inside the container using devcontainer exec or ./not_devcontainer exec devcontainer. See ./ide --help.\n' >&2
	exit 2
	;;
esac

if [ "$editor_command" != --print-uri ] && ! command -v "$editor_command" >/dev/null 2>&1; then
	printf 'IDE command not found: %s. Add the host editor launcher to PATH.\n' "$editor_command" >&2
	exit 127
fi

if [ -n "$workspace_filename" ]; then
	# Keep the host file and container path relative to the same workspace mount.
	case "$workspace_filename" in
	*/*)
		printf 'Choose a workspace filename in the repository root.\n' >&2
		exit 2
		;;
	*.code-workspace) ;;
	*)
		printf 'Expected a .code-workspace filename: %s\n' "$workspace_filename" >&2
		exit 2
		;;
	esac
	if [ ! -f "$workspace_directory/$workspace_filename" ]; then
		printf 'Workspace file not found: %s\n' "$workspace_filename" >&2
		exit 1
	fi
else
	for workspace_candidate in "$workspace_directory"/*.code-workspace; do
		[ -f "$workspace_candidate" ] || continue
		if [ -n "$workspace_filename" ]; then
			printf 'Multiple workspace files found. Use ./ide %s WORKSPACE.code-workspace\n' "$editor_command" >&2
			exit 2
		fi
		workspace_filename=${workspace_candidate##*/}
	done
fi

windows_editor_executable=
windows_editor_cli=
is_vscode=false
case "${editor_command##*/}" in
code | code-insiders)
	is_vscode=true
	if [ -n "${WSL_DISTRO_NAME:-}" ]; then
		# The WSL launcher manages WSL extensions. Call its Windows CLI directly
		# so the prerequisite extensions are installed on the host instead.
		editor_launcher=$(readlink -f "$(command -v "$editor_command")")
		editor_installation_directory=$(dirname -- "$(dirname -- "$editor_launcher")")
		editor_executable_name=Code.exe
		[ "${editor_command##*/}" != code-insiders ] || editor_executable_name='Code - Insiders.exe'
		windows_editor_executable="$editor_installation_directory/$editor_executable_name"
		# Newer Windows releases keep their CLI under the launcher's VERSIONFOLDER.
		editor_version_directory=$(sed -n 's/^VERSIONFOLDER="\([[:alnum:]]*\)"$/\1/p' "$editor_launcher")
		editor_cli_path="$editor_installation_directory/${editor_version_directory:+$editor_version_directory/}resources/app/out/cli.js"
		if [ ! -x "$windows_editor_executable" ] || [ ! -f "$editor_cli_path" ]; then
			printf 'Use the Windows VS Code bin/%s launcher from WSL. Could not locate its host CLI.\n' "${editor_command##*/}" >&2
			exit 1
		fi
		windows_editor_cli=$(wslpath -w "$editor_cli_path")
	fi
	;;
esac

# Keep the dev-container authority to apply devcontainer.json customizations.
# VS Code resolves a Windows WSL share directly, avoiding a nested WSL resolver.
host_directory=$workspace_directory
if [ -n "$windows_editor_executable" ]; then
	host_directory=$(wslpath -w "$workspace_directory")
fi
encoded_host_directory=$(printf '%s' "$host_directory" | od -An -v -tx1 | tr -d ' \n')
remote_authority="dev-container+$encoded_host_directory"
if [ -n "${WSL_DISTRO_NAME:-}" ] && [ -z "$windows_editor_executable" ]; then
	# Match the lowercase hostnames used by webview resource URLs.
	wsl_distribution_name=$(printf '%s' "$WSL_DISTRO_NAME" | LC_ALL=C tr '[:upper:]' '[:lower:]')
	remote_authority="$remote_authority@wsl+$wsl_distribution_name"
fi

remote_path=/workspaces/
uri_argument=--folder-uri
if [ -n "$workspace_filename" ]; then
	remote_path="$remote_path$workspace_filename"
	uri_argument=--file-uri
fi
# Preserve the .code-workspace suffix: editor CLIs use it to distinguish a
# workspace from an ordinary file. Encode spaces, #, %, and Unicode bytes.
encoded_remote_path=$(
	printf '%s' "$remote_path" | od -An -v -tu1 | LC_ALL=C awk '
		{
			for (byte_index = 1; byte_index <= NF; byte_index++) {
				byte_value = $byte_index
				if ((byte_value >= 48 && byte_value <= 57) ||
				    (byte_value >= 65 && byte_value <= 90) ||
				    (byte_value >= 97 && byte_value <= 122) ||
				    index("/-._~", sprintf("%c", byte_value)))
					printf "%c", byte_value
				else
					printf "%%%02X", byte_value
			}
		}'
)
remote_uri="vscode-remote://$remote_authority$encoded_remote_path"

if [ "$editor_command" = --print-uri ]; then
	printf '%s\n' "$remote_uri"
	exit 0
fi

if [ "$is_vscode" = true ]; then
	ensure_vscode_extensions "$@"
fi

use_default_window=true
for editor_argument; do
	case "$editor_argument" in
	--reuse-window | --reuse-window=* | -r | --new-window | --new-window=* | -n) use_default_window=false ;;
	esac
done
if [ "$use_default_window" = true ]; then
	run_editor --new-window "$uri_argument" "$remote_uri" "$@"
else
	run_editor "$uri_argument" "$remote_uri" "$@"
fi
