#!/bin/bash
session_environment="${XDG_RUNTIME_DIR:-/tmp/desktop-runtime-$(id -u)}/session.env"
if [[ -r $session_environment ]]; then
  # shellcheck source=/dev/null
  source "$session_environment"
fi

CHROME_PORT="${CHROME_REMOTE_DEBUGGING_PORT:-9223}"
_profile="${CHROME_USER_DATA_DIR:-/home/developer/chrome-profile}"

_chrome_ready() {
  curl -sf --max-time 1 "http://localhost:${CHROME_PORT}/json/version" >/dev/null 2>&1
}

if ! _chrome_ready; then
  chown -R "$(id -u):$(id -g)" "$_profile" 2>/dev/null || true
  rm -f "$_profile/SingletonLock" "$_profile/SingletonSocket" "$_profile/SingletonCookie" 2>/dev/null
  nohup env DISPLAY=:99 /usr/bin/google-chrome \
    --enable-unsafe-swiftshader \
    --remote-debugging-port="${CHROME_PORT}" \
    --remote-debugging-address=0.0.0.0 \
    --remote-allow-origins="*" \
    --enable-features=WebMCP \
    --user-data-dir="$_profile" \
    "${@:-about:blank}" >/tmp/chrome.log 2>&1 &
  for ((attempt = 0; attempt < 20; attempt++)); do
    _chrome_ready && break
    sleep 0.5
  done
  _chrome_ready || echo "Chrome may have failed to start; check /tmp/chrome.log" >&2
fi
