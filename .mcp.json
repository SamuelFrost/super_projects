{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "compose",
        "--project-directory", "${workspaceFolder}/.devcontainer",
        "-f", "${workspaceFolder}/.devcontainer/compose.yaml",
        "exec", "-T",
        "devcontainer",
        "mise", "exec", "--",
        "chrome-devtools-mcp",
        "--browser-url=http://127.0.0.1:9223"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
