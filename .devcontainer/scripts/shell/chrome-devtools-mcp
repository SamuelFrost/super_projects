#!/bin/sh
# Shared Chrome DevTools MCP launcher for Cursor, VS Code, Codex, and Gemini.
# development and browsing attach to the desktop Chrome started by /usr/local/bin/chrome.
# The port is CHROME_REMOTE_DEBUGGING_PORT (default 9223).

# development — app work only. Extra experimental features.
# browsing — general web browsing purposes network headers that carry credentials are redacted and performance metrics are disabled.
# pwa — install and launch Progressive Web Apps. Starts a separate Chrome over a
#   pipe; those tools cannot attach to the shared desktop Chrome.
#
# Extension tools need a pipe-launched browser, so they stay off on every mode.
#
# Editors start this script with cwd outside the workspace (often $HOME). mise
# then has two installed chrome-devtools-mcp versions and no pin, so the shim
# exits. -C loads the workspace .mise.toml for every devcontainer user.
script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
workspace_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
chrome_port="${CHROME_REMOTE_DEBUGGING_PORT:-9223}"
mode="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$mode" in
  development)
    mise exec -C "$workspace_root" -- chrome-devtools-mcp \
      --browser-url="http://127.0.0.1:${chrome_port}" \
      --category-experimental-third-party \
      --category-experimental-webmcp \
      --experimental-devtools \
      --experimental-vision \
      --experimental-memory \
      --experimental-structured-content \
      --experimental-include-all-pages \
      --experimental-screencast \
      "$@"
    ;;
  browsing)
    mise exec -C "$workspace_root" -- chrome-devtools-mcp \
      --browser-url="http://127.0.0.1:${chrome_port}" \
      --redact-network-headers \
      --no-performance-crux \
      "$@"
    ;;
  pwa)
    # The container desktop is Xvfb :99.
    env DISPLAY=:99 mise exec -C "$workspace_root" -- chrome-devtools-mcp \
      --category-pwa \
      --executable-path=/usr/bin/google-chrome \
      --user-data-dir=/home/developer/chrome-profile/pwa \
      --chrome-arg=--enable-unsafe-swiftshader \
      "$@"
    ;;
  *)
    echo "usage: chrome-devtools-mcp development|browsing|pwa" >&2
    exit 1
    ;;
esac
