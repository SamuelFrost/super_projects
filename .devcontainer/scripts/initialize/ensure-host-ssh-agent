#!/bin/sh
# Run on the host from devcontainer initializeCommand (before the container starts).
# VS Code, Cursor, and `devcontainer up` all invoke this automatically.
#
# Ensures a host ssh-agent socket (private keys stay on the host), writes
# .devcontainer/.env, and loads default SSH keys when possible:
# - Reuse an already-unlocked agent (desktop session, 1Password, prior Keychain).
# - macOS Keychain / quiet add when no prompt is needed.
# - If still empty: prompt via TTY or platform askpass/Keychain UI (still during initializeCommand).
set -eu

cd "$(dirname "$0")/../../.."

DEVCONTAINER_ENV_FILE=.devcontainer/.env
MANAGED_AGENT_SOCK="${XDG_RUNTIME_DIR:-$HOME/.cache}/super_projects_development-ssh-agent.sock"

# WSLg's XDG_RUNTIME_DIR can leave a directory at the socket path; use ~/.cache on WSL.
case "${XDG_RUNTIME_DIR:-}" in
  /mnt/wslg/*) MANAGED_AGENT_SOCK="$HOME/.cache/super_projects_development-ssh-agent.sock" ;;
  *) MANAGED_AGENT_SOCK="${XDG_RUNTIME_DIR:-$HOME/.cache}/super_projects_development-ssh-agent.sock" ;;
esac

mkdir -p "$HOME/.ssh"
touch "$HOME/.ssh/known_hosts"
chmod 700 "$HOME/.ssh" 2>/dev/null || true

HOST_OS=$(uname -s 2>/dev/null || echo unknown)

DEFAULT_KEY_PATHS="
$HOME/.ssh/id_ed25519
$HOME/.ssh/id_rsa
$HOME/.ssh/id_ecdsa
$HOME/.ssh/id_ed25519_sk
$HOME/.ssh/id_ecdsa_sk
"

agent_has_loaded_keys() {
  _socket_path=$1
  [ -S "$_socket_path" ] || return 1
  SSH_AUTH_SOCK="$_socket_path" ssh-add -l >/dev/null 2>&1
}

agent_is_running() {
  _socket_path=$1
  [ -S "$_socket_path" ] || return 1
  _ssh_add_output=$(SSH_AUTH_SOCK="$_socket_path" ssh-add -l 2>&1) && return 0
  echo "$_ssh_add_output" | grep -qi 'no identities' && return 0
  return 1
}

# Prefer an agent that already has unlocked keys (zero prompt).
SELECTED_AGENT_SOCK=
if [ -n "${SSH_AUTH_SOCK:-}" ] && agent_has_loaded_keys "$SSH_AUTH_SOCK"; then
  SELECTED_AGENT_SOCK=$SSH_AUTH_SOCK
fi
if [ -z "$SELECTED_AGENT_SOCK" ]; then
  set -- \
    "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" \
    "$HOME/.1password/agent.sock"
  for _onepassword_sock in "$@"; do
    if agent_has_loaded_keys "$_onepassword_sock"; then
      SELECTED_AGENT_SOCK=$_onepassword_sock
      break
    fi
  done
fi
if [ -z "$SELECTED_AGENT_SOCK" ] && agent_has_loaded_keys "$MANAGED_AGENT_SOCK"; then
  SELECTED_AGENT_SOCK=$MANAGED_AGENT_SOCK
fi

# No unlocked keys yet: use our managed socket so loads go to the path we forward.
if [ -z "$SELECTED_AGENT_SOCK" ]; then
  if agent_is_running "$MANAGED_AGENT_SOCK"; then
    SELECTED_AGENT_SOCK=$MANAGED_AGENT_SOCK
  else
    if [ -d "$MANAGED_AGENT_SOCK" ]; then
      rm -rf "$MANAGED_AGENT_SOCK"
    elif [ -e "$MANAGED_AGENT_SOCK" ]; then
      rm -f "$MANAGED_AGENT_SOCK"
    fi
    ssh-agent -a "$MANAGED_AGENT_SOCK" >/dev/null
    SELECTED_AGENT_SOCK=$MANAGED_AGENT_SOCK
  fi
fi

export SSH_AUTH_SOCK=$SELECTED_AGENT_SOCK

add_key_without_prompt() {
  _key_path=$1
  [ -f "$_key_path" ] || return 0
  if [ "$HOST_OS" = Darwin ]; then
    ssh-add --apple-use-keychain "$_key_path" </dev/null >/dev/null 2>&1 || true
  else
    ssh-add -q "$_key_path" </dev/null >/dev/null 2>&1 || true
  fi
}

add_key_with_prompt() {
  _key_path=$1
  [ -f "$_key_path" ] || return 0
  if [ "$HOST_OS" = Darwin ]; then
    echo "SSH: unlock $_key_path (macOS Keychain)..." >&2
    ssh-add --apple-use-keychain "$_key_path" || true
  else
    echo "SSH: unlock $_key_path..." >&2
    ssh-add "$_key_path" || true
  fi
}

# 1) Non-interactive / Keychain cache hits
for _key_path in $DEFAULT_KEY_PATHS; do
  add_key_without_prompt "$_key_path"
done

# 2) Still empty: prompt as part of initializeCommand (not a separate user-run script)
if ! agent_has_loaded_keys "$SELECTED_AGENT_SOCK"; then
  _found_default_key=0
  for _key_path in $DEFAULT_KEY_PATHS; do
    [ -f "$_key_path" ] || continue
    _found_default_key=1
    break
  done

  if [ "$_found_default_key" -eq 1 ]; then
    if [ -t 0 ] || [ -t 1 ]; then
      echo "SSH: no identities in the host agent yet; unlock keys for this devcontainer..." >&2
      for _key_path in $DEFAULT_KEY_PATHS; do
        add_key_with_prompt "$_key_path"
      done
    elif [ "$HOST_OS" = Darwin ]; then
      # Cursor/VS Code initializeCommand often has no TTY; Keychain may still present UI.
      echo "SSH: attempting Keychain unlock (may show a system prompt)..." >&2
      for _key_path in $DEFAULT_KEY_PATHS; do
        [ -f "$_key_path" ] || continue
        ssh-add --apple-use-keychain "$_key_path" 2>/dev/null || true
      done
    else
      _askpass_program=
      if command -v ssh-askpass >/dev/null 2>&1; then
        _askpass_program=$(command -v ssh-askpass)
      elif command -v ksshaskpass >/dev/null 2>&1; then
        _askpass_program=$(command -v ksshaskpass)
      elif command -v lxqt-openssh-askpass >/dev/null 2>&1; then
        _askpass_program=$(command -v lxqt-openssh-askpass)
      fi
      if [ -n "$_askpass_program" ] && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        echo "SSH: unlocking keys via askpass (system prompt)..." >&2
        for _key_path in $DEFAULT_KEY_PATHS; do
          [ -f "$_key_path" ] || continue
          SSH_ASKPASS=$_askpass_program SSH_ASKPASS_REQUIRE=force ssh-add "$_key_path" </dev/null 2>/dev/null || true
        done
      fi
    fi
  fi
fi

{
  printf 'DEVELOPER_UID=%s\n' "$(id -u)"
  printf 'DOCKER_GID=%s\n' "$(stat -c '%g' /var/run/docker.sock 2>/dev/null || stat -f '%g' /var/run/docker.sock)"
  printf 'HOST_HOME_DIR=%s\n' "$HOME"
  printf 'HOST_SSH_AUTH_SOCK=%s\n' "$SELECTED_AGENT_SOCK"
} >"$DEVCONTAINER_ENV_FILE"

if agent_has_loaded_keys "$SELECTED_AGENT_SOCK"; then
  echo "SSH: host agent ready ($(SSH_AUTH_SOCK=$SELECTED_AGENT_SOCK ssh-add -l 2>/dev/null | wc -l | tr -d ' ') key(s))" >&2
elif [ -n "${SSH_AUTH_SOCK:-}" ]; then
  echo "SSH: host agent has no identities yet." >&2
  echo "  Reopen/rebuild may prompt again, or enable 1Password SSH agent / macOS Keychain." >&2
  echo "  GitHub HTTPS alternative: gh auth login (inside the container)." >&2
fi
