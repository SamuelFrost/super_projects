{
  "mcpServers": {
    "chrome-devtools": {
      "command": "sh",
      "args": [
        ".devcontainer/scripts/shell/exec-in-devcontainer",
        "mise", "exec", "-C", "/workspaces", "--",
        "chrome-devtools-mcp",
        "--browser-url=http://127.0.0.1:9223"
      ],
      "timeout": 120000
    },
    "figma": {
      "httpUrl": "https://mcp.figma.com/mcp",
      "timeout": 120000
    }
  }
}
