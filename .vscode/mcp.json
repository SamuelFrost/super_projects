{
  "inputs": [],
  "servers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "sh",
      "args": [
        ".devcontainer/scripts/shell/exec-in-devcontainer",
        "mise", "exec", "-C", "/workspaces", "--",
        "chrome-devtools-mcp",
        "--browser-url=http://127.0.0.1:9223"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
