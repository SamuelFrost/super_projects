{
  "mcpServers": {
    "chrome-devtools": {
      "command": "docker",
      "args": [
        "compose",
        "-f", ".devcontainer/compose.yaml",
        "--project-directory", ".devcontainer",
        "exec", "-T",
        "devcontainer",
        "mise",
        "exec",
        "-C",
        "/workspaces",
        "--",
        "chrome-devtools-mcp",
        "--browser-url=http://127.0.0.1:9223"
      ]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
