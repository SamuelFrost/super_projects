// For format details, see https://containers.dev/implementors/json_reference/.
{
  // devcontainer.json customization for name is pending for devcontainer extends feature (see status: https://github.com/devcontainers/spec/issues/22)
  "name": "super_projects",
  "dockerComposeFile": [
    "compose.yaml",
    "docker_compose_configuration_customizations/naming/compose.naming.yaml",
    "docker_compose_configuration_customizations/naming/compose.naming.override.yaml",
    "docker_compose_configuration_customizations/host_filesystem_compatibility/compose.user-ids.yaml",
    "docker_compose_configuration_customizations/host_filesystem_compatibility/compose.project-directory.yaml",
    "docker_compose_configuration_customizations/ssh_agent_socket/compose.ssh-agent-socket.yaml",
    "docker_compose_configuration_customizations/ssh_known_hosts/compose.ssh-known-hosts.yaml"
  ],
  "service": "devcontainer",

  // devcontainer.json customization for workspaceFolder is pending for devcontainer extends feature (see status: https://github.com/devcontainers/spec/issues/22)
  "workspaceFolder": "/workspaces/",
  "shutdownAction": "none",

  // "remoteUser": "developer",
  // "updateRemoteUserUID": true,

  // initializeCommand.sh (host): ssh-agent + key unlock, generated Compose files, persist dirs.
  "initializeCommand": "sh .devcontainer/scripts/shell/initializeCommand.sh",

  "postStartCommand": "ensure-auth && print-cursor-worker-hint",

  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  // Features are largely handled by the Dockerfile directly for finer control,
  // but the equivalent devcontainer features are listed here for reference.
  "features": {
    // "ghcr.io/devcontainers/features/github-cli:1": {},
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
    //   "moby": false,
    //   "dockerDashComposeVersion": "v2"
    // }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "marcoroth.herb-lsp",
        "marcoroth.stimulus-lsp",
        "biomejs.biome",
        "vitest.explorer",
        "zoma.vscode-auto-open-workspace",
        "ms-azuretools.vscode-containers",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-wsl",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-server",
        "ms-vscode.remote-explorer"
      ],
      "settings": {
        "autoOpenWorkspace.enableAutoOpenAlwaysFirst": true,
        // Named-volume shortcuts under persist/ can be huge (mise installs, Chrome profile).
        // Keep them out of the workspace file watcher and search index.
        "files.watcherExclude": {
          "**/.devcontainer/persist/mise/**": true,
          "**/.devcontainer/persist/chrome/**": true,
          "**/.devcontainer/persist/cursor/**": true
        },
        "search.exclude": {
          "**/.devcontainer/persist/mise": true,
          "**/.devcontainer/persist/chrome": true,
          "**/.devcontainer/persist/cursor": true
        }
      }
    }
  }
}
