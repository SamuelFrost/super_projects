#!/bin/sh
# Run a command in the devcontainer Compose service. Invoked as:
#   sh .devcontainer/scripts/shell/exec-in-devcontainer <cmd...>
# MCP hosts do not share a cwd; locate the repo from $0 (or git).
set -eu

repo_root() {
  _script=$0
  if [ -n "$_script" ] && [ -e "$_script" ]; then
    _dir=$(CDPATH= cd -- "$(dirname "$_script")" && pwd)
    _root=$(CDPATH= cd -- "$_dir/../../.." && pwd)
    if [ -f "$_root/.devcontainer/compose.yaml" ]; then
      printf '%s\n' "$_root"
      return 0
    fi
  fi
  git rev-parse --show-toplevel 2>/dev/null
}

ROOT=$(repo_root) || {
  echo "exec-in-devcontainer: cannot locate repository root from \$0 ($0) or git" >&2
  exit 1
}

cd "$ROOT"
exec docker compose \
  -f .devcontainer/compose.yaml \
  --project-directory .devcontainer \
  exec -T devcontainer "$@"
