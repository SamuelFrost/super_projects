# Copy this file to .env.namespace_override:
#   cp .devcontainer/.env.namespace_override.example .devcontainer/.env.namespace_override
# KEY=value lines. initializeCommand reads SUPER_PROJECTS_NAME.
# Do not set this in generated .env — initialize overwrites that file.

# Compose project name. Isolates volumes, network, container name, and the
# host ssh-agent socket. Omitting this file silently keeps super_projects and
# will share those with any other default clone on this Docker daemon.
# Changing an existing name: compose down the old project first (or otherwise
# remove the containers); volumes do not migrate.
SUPER_PROJECTS_NAME=super_projects
