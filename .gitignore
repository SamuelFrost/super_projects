# Ignore everything by default — this repo only tracks the dev environment scaffolding,
# not any of the projects that live inside this directory.
*

# Unignore the dev environment and IDE config directories/files
!.gitignore
!.devcontainer/
!.devcontainer/**
!.cursor/
!.cursor/**
!.claude/
!.claude/**
!.codex/
!.codex/**
!.gemini/
!.gemini/**
!.vscode/
!.vscode/**
!.mcp.json
!README.md
!LICENSE
!.mise.toml
!.agents/
!.agents/**
!.samples/
!.samples/**

# ignore Agent-generated plans by default
.cursor/plans/**
.claude/plans/**
.codex/plans/**
.gemini/plans/**
.vscode/plans/**

# Always ignore local-only files, including under otherwise whitelisted dirs.
**/.local_only/
**/.local_only/**

# Ignore generated/persisted files even though the parent dirs are whitelisted above
.devcontainer/.env
.devcontainer/.env.namespace_override
.devcontainer/.selected-ssh-agent.env
.devcontainer/compose.generated.yaml
.devcontainer/docker_compose_configuration_customizations/naming/compose.naming.override.yaml
.devcontainer/docker_compose_configuration_customizations/host_filesystem_compatibility/compose.user-ids.yaml
.devcontainer/docker_compose_configuration_customizations/host_filesystem_compatibility/compose.project-directory.yaml
.devcontainer/docker_compose_configuration_customizations/ssh_agent_socket/compose.ssh-agent-socket.yaml
.devcontainer/docker_compose_configuration_customizations/ssh_known_hosts/compose.ssh-known-hosts.yaml

# Persist shortcut dirs are Docker mount points on the host (often empty); keep README tracked
.devcontainer/persist/*
!.devcontainer/persist/README.md
.devcontainer/cursor-migration-backup/
