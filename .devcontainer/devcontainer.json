// For format details, see https://containers.dev/implementors/json_reference/.
{
  "name": "super_projects_development",
  "dockerComposeFile": "compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/",
  "shutdownAction": "none",

  // "remoteUser": "developer",
  // "updateRemoteUserUID": true,

  // Host-side hook before the container starts (VS Code, Cursor, and `devcontainer up` etc.).
  // ensure-host-ssh-agent writes .devcontainer/.env (DEVELOPER_UID, DOCKER_GID, HOST_HOME_DIR,
  // HOST_SSH_AUTH_SOCK), forwards only the ssh-agent socket, and may prompt once to unlock keys.
  "initializeCommand": "sh .devcontainer/scripts/initialize/ensure-host-ssh-agent && mkdir -p .devcontainer/persist/gemini .devcontainer/persist/gh .devcontainer/persist/git .devcontainer/persist/mise .devcontainer/persist/chrome",

  // Expose localWorkspaceFolder so tools inside the container can reference the host path
  "remoteEnv": { "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}" },

  "containerEnv": {
    "EDITOR": "code",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },

  "postStartCommand": "ensure-auth && print-cursor-worker-hint",

  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  // Features are largely handled by the Dockerfile directly for finer control,
  // but the equivalent devcontainer features are listed here for reference.
  "features": {
    // "ghcr.io/devcontainers/features/github-cli:1": {},
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
    //   "moby": false,
    //   "dockerDashComposeVersion": "v2"
    // }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "marcoroth.herb-lsp",
        "marcoroth.stimulus-lsp",
        "biomejs.biome",
        "vitest.explorer",
        "zoma.vscode-auto-open-workspace",
        "ms-azuretools.vscode-containers",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-wsl",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-server",
        "ms-vscode.remote-explorer"
      ],
      "settings": {
        "autoOpenWorkspace.enableAutoOpenAlwaysFirst": true,
        // Named-volume shortcuts under persist/ can be huge (mise installs, Chrome profile).
        // Keep them out of the workspace file watcher and search index.
        "files.watcherExclude": {
          "**/.devcontainer/persist/mise/**": true,
          "**/.devcontainer/persist/chrome/**": true
        },
        "search.exclude": {
          "**/.devcontainer/persist/mise": true,
          "**/.devcontainer/persist/chrome": true
        }
      }
    }
  }
}
